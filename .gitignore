# --- Secrets / credentials -----------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
*.token
credentials.json
service-account*.json
secrets/

# --- Supabase ------------------------------------------------------------
# Local Supabase CLI state — never commit. (Folder `supabase/` for project
# SQL/migrations IS tracked.)
.supabase/
supabase/.branches/
supabase/.temp/

# --- n8n -----------------------------------------------------------------
# Workflow JSON exports often contain encrypted credential blobs. Keep
# credential-bearing exports out of git; only commit sanitized workflows.
n8n-workflows/credentials/
n8n-workflows/*-with-credentials.json
n8n-workflows/*.env

# --- Telegram bot --------------------------------------------------------
telegram-bot/.env
telegram-bot/node_modules/
telegram-bot/dist/
telegram-bot/build/
telegram-bot/*.log

# --- Node --------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Python (in case of helper scripts) ----------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# --- OS ------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Editors -------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# --- Local-only scratch --------------------------------------------------
*.local
scratch/
tmp/
.cache/
